# Copy this file to ".env" (same folder) and fill in your own key. Never commit .env.
# Smart mode (AI check) is OFF when LLM_API_KEY is empty; the app then uses NLTK only.

# Get a key at https://console.x.ai (xAI Grok) or https://aistudio.google.com (Gemini).
LLM_API_KEY=

# "xai" (Grok, default), "gemini", or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=xai

# Leave empty to let the app pick a Grok text model from your key's model list,
# or set one from https://docs.x.ai/docs/models (for Gemini: gemini-flash-latest).
LLM_MODEL=

# Only for xai/openai. Default for xai: https://api.x.ai/v1
LLM_BASE_URL=

# Seconds before the AI call gives up and the NLTK result is used.
LLM_TIMEOUT=10
