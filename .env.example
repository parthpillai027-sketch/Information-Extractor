# Copy this file to ".env" (same folder) and fill in your own key. Never commit .env.
# Smart mode (AI check) is OFF when LLM_API_KEY is empty; the app then uses NLTK only.

# Get a free key at https://aistudio.google.com (Gemini) or one at https://console.x.ai (xAI Grok).
LLM_API_KEY=

# "gemini", "xai" (Grok; the default when this line is empty), or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=gemini

# Empty = gemini-3.1-flash-lite for Gemini (fast), or for xai the app picks a Grok text
# model from your key's model list.
LLM_MODEL=gemini-3.1-flash-lite

# Only for xai/openai. Default for xai: https://api.x.ai/v1
LLM_BASE_URL=

# Seconds for the whole AI step (a busy retry included); after that the NLTK result is used.
LLM_TIMEOUT=25
